<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/notification_album_bg">

        <ImageView
            android:id="@+id/notification_album"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:alpha="0.92"
            android:scaleType="centerInside"
            android:src="@mipmap/ic_launcher" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#171A1F"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/notification_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#6B7280"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/notification_previous"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:padding="9dp"
        android:scaleType="center"
        android:src="@drawable/ic_notify_previous" />

    <ImageButton
        android:id="@+id/notification_toggle"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/notification_play_bg"
        android:padding="11dp"
        android:scaleType="center"
        android:src="@drawable/ic_notify_pause" />

    <ImageButton
        android:id="@+id/notification_next"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@android:color/transparent"
        android:padding="9dp"
        android:scaleType="center"
        android:src="@drawable/ic_notify_next" />
</LinearLayout>
