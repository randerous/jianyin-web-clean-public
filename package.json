{
  "name": "jianyin-web-clean",
  "version": "1.0.14",
  "description": "既见音乐播放器 Windows 桌面版",
  "author": "randerous",
  "private": true,
  "type": "module",
  "main": "electron-main.mjs",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "tsc && vite build",
    "android:sync": "npm run build && cap sync android && node scripts/prepare-android-embedded-backend.mjs",
    "android:prepare": "node scripts/prepare-android-embedded-backend.mjs",
    "android:apk": "node scripts/build-android-apk.mjs",
    "android:open": "cap open android",
    "preview": "node server.mjs",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "node scripts/run-api-tests.mjs",
    "test:e2e": "playwright test --config playwright.config.ts && node scripts/generate-test-status.mjs",
    "test:perf": "npm run build && npm run test:perf:run",
    "test:perf:run": "playwright test --config playwright.performance.config.ts && node scripts/generate-test-status.mjs",
    "test:status": "node scripts/generate-test-status.mjs",
    "test:status:reset": "node scripts/generate-test-status.mjs --reset",
    "test:all": "npm run test:status:reset && npm run build && npm test && npm run test:perf:run",
    "test:smoke:flac": "node --test tests/smoke/real-flac.smoke.mjs",
    "test:smoke:playlist": "playwright test --grep \"remote playlists persist across clean browser contexts\" --project=chromium",
    "test:desktop-package": "node --test tests/windows-portable.test.mjs",
    "desktop:package:windows": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@red-mobile/nodejs-mobile-cordova": "3.4.2",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "NeteaseCloudMusicApi": "^4.32.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "playwright": "^1.60.0"
  },
  "build": {
    "appId": "com.randerous.jianyin.desktop",
    "productName": "既见",
    "artifactName": "既见-${version}-windows-portable.${ext}",
    "asar": false,
    "beforePack": "scripts/electron-builder-hooks.mjs",
    "afterPack": "scripts/electron-builder-hooks.mjs",
    "files": [
      "dist/**",
      "public/assets/icon.png",
      "electron-main.mjs",
      "server.mjs",
      "package.json",
      "!**/._*"
    ],
    "win": {
      "target": "portable",
      "icon": "public/assets/icon.png",
      "signAndEditExecutable": false
    },
    "directories": {
      "output": "release"
    }
  }
}
