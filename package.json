{
  "name": "jianyin-web-clean",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs --dev",
    "build": "tsc && vite build",
    "android:sync": "npm run build && cap sync android && node scripts/prepare-android-embedded-backend.mjs",
    "android:prepare": "node scripts/prepare-android-embedded-backend.mjs",
    "android:apk": "node scripts/build-android-apk.mjs",
    "android:open": "cap open android",
    "preview": "node server.mjs",
    "test": "npm run test:api && npm run test:e2e",
    "test:api": "node --test tests/server.test.mjs",
    "test:e2e": "playwright test",
    "test:smoke:flac": "REAL_FLAC_SMOKE=1 node --test --test-name-pattern \"real flac source smoke\" tests/server.test.mjs",
    "test:smoke:playlist": "playwright test --grep \"remote playlists persist across clean browser contexts\" --project=chromium"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@red-mobile/nodejs-mobile-cordova": "3.4.2",
    "@vitejs/plugin-react": "latest",
    "express": "^5.2.1",
    "lucide-react": "latest",
    "NeteaseCloudMusicApi": "^4.32.0",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.60.0"
  }
}
